{
  "name": "@telepilotco/n8n-nodes-telepilot",
  "version": "0.5.3",
  "description": "Open-source, security-hardened n8n community nodes for Telegram user-account automation via TDLib",
  "keywords": [
    "telepilot.co",
    "telepilot",
    "telegram",
    "telegram-api",
    "MTProto",
    "open-source",
    "node-addon",
    "n8n-community-node-package"
  ],
  "files": [
    "dist",
    "deploy/test-n8n-imports"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nickovall/n8n-nodes-telepilot#readme",
  "author": {
    "name": "Nikolai Kovalsky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickovall/n8n-nodes-telepilot.git"
  },
  "bugs": {
    "url": "https://github.com/nickovall/n8n-nodes-telepilot/issues"
  },
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','.tmp']) fs.rmSync(p,{recursive:true,force:true});\"",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier package.json nodes credentials --write",
    "lint": "eslint package.json nodes credentials",
    "lint:prepublish": "eslint -c .eslintrc.prepublish.js package.json nodes credentials",
    "lintfix": "eslint nodes credentials package.json --fix",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint:prepublish"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TelePilotApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TelePilot/TelePilot.node.js",
      "dist/nodes/TelePilot/TelePilotTrigger.node.js"
    ]
  },
  "telepilot": {
    "tdlibBinaryVersion": "1.8.14-rebuilt"
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/node": "^14.14.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-core": "^1.19.5",
    "n8n-workflow": "^1.19.5",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  },
  "dependencies": {
    "@telepilotco/tdl": "^7.4.1",
    "debug": "^4.3.4",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0"
  }
}
